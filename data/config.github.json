{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "glm-4.5-flash",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "api_key_env": "GLM_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "owner": "anthropics",
        "repo": "claude-code",
        "enabled": true
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "model-update"
      },
      {
        "name": "Google DeepMind",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "model-update"
      },
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "Latent Space",
        "url": "https://www.latent.space/feed",
        "enabled": true,
        "category": "ai-tools"
      },
      {
        "name": "One Useful Thing",
        "url": "https://www.oneusefulthing.org/feed",
        "enabled": true,
        "category": "ai-business"
      },
      {
        "name": "TLDR AI",
        "url": "https://tldr.tech/api/rss/ai",
        "enabled": true,
        "category": "ai-news"
      },
      {
        "name": "GitHub Trending Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 80
        }
      ],
      "users": [],
      "fetch_comments": 8
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [
        "ai",
        "llm",
        "agent",
        "mcp",
        "claude",
        "gpt",
        "prompt",
        "rag",
        "skill"
      ],
      "min_stars": 50,
      "max_items": 20
    }
  },
  "filtering": {
    "ai_score_threshold": 7.0,
    "time_window_hours": 24,
    "max_items": 15
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {
      "title": "🌅 AI 日报 #{date}（精选 #{important_items} 条）",
      "body": "#{summary?limit=1500}"
    },
    "headers": ""
  }
}
